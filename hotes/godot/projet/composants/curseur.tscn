[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/liaison.gd" id="1_liaison"]
[ext_resource type="Script" path="res://scripts/geste.gd" id="2_geste"]

[node name="Curseur" type="HBoxContainer"]
theme_type_variation = &"RangeeSerree"
size_flags_horizontal = 3

[node name="Nom" type="Label" parent="."]
custom_minimum_size = Vector2(180, 0)
size_flags_horizontal = 3
autowrap_mode = 3

[node name="libelle" type="Node" parent="Nom"]
script = ExtResource("1_liaison")
champ = "libelle"

[node name="ton" type="Node" parent="Nom"]
script = ExtResource("1_liaison")
champ = "ton"
propriete = &"theme_type_variation"

[node name="Glissiere" type="HSlider" parent="."]
custom_minimum_size = Vector2(180, 0)
size_flags_horizontal = 3
size_flags_vertical = 4
scrollable = false

[node name="min" type="Node" parent="Glissiere"]
script = ExtResource("1_liaison")
champ = "min"
propriete = &"min_value"

[node name="max" type="Node" parent="Glissiere"]
script = ExtResource("1_liaison")
champ = "max"
propriete = &"max_value"

[node name="pas" type="Node" parent="Glissiere"]
script = ExtResource("1_liaison")
champ = "pas"
propriete = &"step"

[node name="valeur" type="Node" parent="Glissiere"]
script = ExtResource("1_liaison")
champ = "valeur"
propriete = &"value"

[node name="infobulle" type="Node" parent="Glissiere"]
script = ExtResource("1_liaison")
champ = "refus"
propriete = &"tooltip_text"

[node name="Geste" type="Node" parent="Glissiere" node_paths=PackedStringArray("boite")]
script = ExtResource("2_geste")
boite = NodePath("../../Nombre")

[node name="Nombre" type="SpinBox" parent="."]
