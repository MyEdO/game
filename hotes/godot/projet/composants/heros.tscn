[node name="Portrait" type="HBoxContainer" parent="Rangee"]
size_flags_vertical = 0

[node name="Zone" type="Node" parent="Rangee/Portrait" node_paths=PackedStringArray("masque")]
script = ExtResource("2_zone")
source = "elements"
ids = PackedStringArray("portrait")
masque = NodePath("..")

[node name="Pile" type="VBoxContainer" parent="Rangee"]
