[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/liaison.gd" id="1_liaison"]
[ext_resource type="Script" path="res://scripts/geste.gd" id="2_geste"]
[ext_resource type="Script" path="res://scripts/dessin.gd" id="3_dessin"]
[ext_resource type="Script" path="res://scripts/bulle.gd" id="9_bulle"]

[node name="Outil" type="VBoxContainer"]
mouse_filter = 2

[node name="Presser" type="Button" parent="."]
focus_mode = 0
script = ExtResource("9_bulle")
custom_minimum_size = Vector2(85, 0)
theme_type_variation = &"Outil"
toggle_mode = true
icon_alignment = 1
vertical_icon_alignment = 0

[node name="Disque" type="Panel" parent="Presser"]
show_behind_parent = true
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -23.0
offset_right = 23.0
offset_bottom = 46.0
grow_horizontal = 2
mouse_filter = 2
theme_type_variation = &"DisqueDOutil"

[node name="libelle" type="Node" parent="Presser"]
script = ExtResource("1_liaison")
champ = "libelle"

[node name="Dessin" type="Node" parent="Presser"]
script = ExtResource("3_dessin")
champ = "icone"

[node name="presse" type="Node" parent="Presser"]
script = ExtResource("1_liaison")
champ = "presse"
propriete = &"button_pressed"

[node name="refus" type="Node" parent="Presser"]
script = ExtResource("1_liaison")
champ = "refus"
propriete = &"disabled"

[node name="Geste" type="Node" parent="Presser"]
script = ExtResource("2_geste")

[node name="detail" type="Node" parent="Presser"]
script = ExtResource("1_liaison")
champ = "detail"
propriete = &"tooltip_text"

[node name="infobulle_refus" type="Node" parent="Presser"]
script = ExtResource("1_liaison")
champ = "refus"
propriete = &"tooltip_text"
a_la_suite = true
