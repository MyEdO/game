[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/liaison.gd" id="1_liaison"]
[ext_resource type="Script" path="res://scripts/zone.gd" id="2_zone"]
[ext_resource type="Theme" path="res://art/rang.tres" id="t_rang"]

[node name="Rang" type="PanelContainer"]
size_flags_horizontal = 0
theme = ExtResource("t_rang")
theme_type_variation = &"Enveloppe"

[node name="Rangee" type="HBoxContainer" parent="."]
theme_type_variation = &"RangeeSerree"

[node name="Cadre" type="PanelContainer" parent="Rangee"]
size_flags_vertical = 4

[node name="ton" type="Node" parent="Rangee/Cadre"]
script = ExtResource("1_liaison")
champ = "ton"
propriete = &"theme_type_variation"

[node name="Portrait" type="HBoxContainer" parent="Rangee/Cadre"]
alignment = 1

[node name="Zone" type="Node" parent="Rangee/Cadre/Portrait"]
script = ExtResource("2_zone")
source = "elements"
ids = PackedStringArray("portrait")
formes = PackedStringArray("portrait:portraitDuRang")

[node name="Fiche" type="PanelContainer" parent="Rangee/Cadre"]
mouse_filter = 2
theme_type_variation = &"Enveloppe"

[node name="Zone" type="Node" parent="Rangee/Cadre/Fiche"]
script = ExtResource("2_zone")
source = "elements"
ids = PackedStringArray("fiche/")
formes = PackedStringArray("bouton:surLeRang")

[node name="Pile" type="VBoxContainer" parent="Rangee"]
size_flags_vertical = 4
theme_type_variation = &"PileTassee"

[node name="Nom" type="Label" parent="Rangee/Pile"]
size_flags_vertical = 4
mouse_filter = 1
text_overrun_behavior = 3
theme_type_variation = &"NomDuRang"

[node name="nom" type="Node" parent="Rangee/Pile/Nom"]
script = ExtResource("1_liaison")
champ = "nom"

[node name="infobulle" type="Node" parent="Rangee/Pile/Nom"]
script = ExtResource("1_liaison")
champ = "nom"
propriete = &"tooltip_text"

[node name="Vie" type="HBoxContainer" parent="Rangee/Pile"]

[node name="Zone" type="Node" parent="Rangee/Pile/Vie"]
script = ExtResource("2_zone")
source = "elements"
ids = PackedStringArray("blessures")
formes = PackedStringArray("jauge:vieDuRang")
