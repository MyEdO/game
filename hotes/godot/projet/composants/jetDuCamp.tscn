[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/liaison.gd" id="1_liaison"]
[ext_resource type="Script" path="res://scripts/zone.gd" id="2_zone"]
[ext_resource type="PackedScene" path="res://composants/portrait.tscn" id="3_portrait"]
[ext_resource type="Theme" path="res://art/rang.tres" id="4_rang"]

[node name="Jet" type="HBoxContainer"]
size_flags_horizontal = 3

[node name="detail" type="Node" parent="."]
script = ExtResource("1_liaison")
champ = "detail"
propriete = &"tooltip_text"

[node name="Cadre" type="PanelContainer" parent="."]
size_flags_vertical = 4
theme = ExtResource("4_rang")
