[node name="Cible" type="Label" parent="Pile/Chiffres"]
theme_type_variation = &"Chiffre"

[node name="cible" type="Node" parent="Pile/Chiffres/Cible"]
script = ExtResource("1_liaison")
champ = "cible"
cacher_si_nul = true

[node name="Resultat" type="PanelContainer" parent="Pile/Chiffres"]
