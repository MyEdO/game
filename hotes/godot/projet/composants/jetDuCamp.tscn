champ = "combattant"
propriete = &"visible"

[node name="Portrait" parent="Cadre" instance=ExtResource("3_portrait")]

[node name="Image" parent="Cadre/Portrait"]
custom_minimum_size = Vector2(64, 64)

[node name="Pile" type="VBoxContainer" parent="."]
size_flags_horizontal = 3
size_flags_vertical = 4

[node name="Tete" type="HFlowContainer" parent="Pile"]

[node name="Qui" type="Label" parent="Pile/Tete"]
theme_type_variation = &"NomDuCamp"

[node name="qui" type="Node" parent="Pile/Tete/Qui"]
script = ExtResource("1_liaison")
champ = "qui"
cacher_si_nul = true

[node name="Modificateurs" type="HFlowContainer" parent="Pile/Tete"]
size_flags_horizontal = 3
size_flags_vertical = 4

[node name="Zone" type="Node" parent="Pile/Tete/Modificateurs"]
script = ExtResource("2_zone")
