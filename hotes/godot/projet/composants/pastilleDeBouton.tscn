[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/liaison.gd" id="1_liaison"]
[ext_resource type="Script" path="res://scripts/geste.gd" id="2_geste"]
[ext_resource type="Script" path="res://scripts/dessin.gd" id="3_dessin"]
[ext_resource type="Theme" path="res://art/fin_du_tour.tres" id="t_fin"]

[node name="PastilleDeBouton" type="CenterContainer"]
size_flags_vertical = 8
theme = ExtResource("t_fin")

[node name="libelle" type="Node" parent="."]
script = ExtResource("1_liaison")
champ = "libelle"
propriete = &"tooltip_text"

[node name="Presser" type="Button" parent="."]
custom_minimum_size = Vector2(36, 36)
mouse_filter = 1
toggle_mode = true
icon_alignment = 1

[node name="Dessin" type="Node" parent="Presser"]
script = ExtResource("3_dessin")
champ = "icone"

[node name="presse" type="Node" parent="Presser"]
script = ExtResource("1_liaison")
champ = "presse"
propriete = &"button_pressed"

[node name="refus" type="Node" parent="Presser"]
script = ExtResource("1_liaison")
champ = "refus"
propriete = &"disabled"

[node name="Geste" type="Node" parent="Presser"]
script = ExtResource("2_geste")

[node name="infobulle" type="Node" parent="Presser"]
script = ExtResource("1_liaison")
champ = "refus"
propriete = &"tooltip_text"
