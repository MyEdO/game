[gd_scene load_steps=4 format=3]

[ext_resource type="PackedScene" path="res://cadres/monde.tscn" id="1_monde"]
[ext_resource type="Script" path="res://scripts/zone.gd" id="2_zone"]
[ext_resource type="Theme" path="res://art/heure.tres" id="t_heure"]

[node name="Monde" instance=ExtResource("1_monde")]

[node name="Marges" parent="Cadre" index="0"]
theme_type_variation = &"MargesDuVoyage"

[node name="Paysage" type="PanelContainer" parent="Cadre/Marges/Colonne/Contenu"]
theme_type_variation = &"Paysage"

[node name="Marges" type="MarginContainer" parent="Cadre/Marges/Colonne/Contenu/Paysage"]
theme_type_variation = &"MargesDuPaysage"

[node name="Scene" type="VBoxContainer" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges"]
theme_type_variation = &"Pile"

[node name="Heure" type="VBoxContainer" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene"]
theme = ExtResource("t_heure")

[node name="Zone" type="Node" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene/Heure"]
script = ExtResource("2_zone")
source = "fenetre.corps"
ids = PackedStringArray("voyage/heure", "voyage/meteo")

[node name="Evenement" type="VBoxContainer" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene"]
size_flags_vertical = 3
alignment = 1

[node name="Zone" type="Node" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene/Evenement"]
script = ExtResource("2_zone")
source = "fenetre.corps"

[node name="Route" type="VBoxContainer" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene"]

[node name="Zone" type="Node" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene/Route"]
script = ExtResource("2_zone")
source = "fenetre.corps"
ids = PackedStringArray("voyage/route")

[node name="Frise" type="HFlowContainer" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene"]
theme_type_variation = &"Frise"

[node name="Zone" type="Node" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene/Frise"]
script = ExtResource("2_zone")
source = "fenetre.corps"
ids = PackedStringArray("voyage/etape/")

[node name="Defilement" type="ScrollContainer" parent="Cadre/Marges/Colonne/Contenu"]
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Jets" type="HFlowContainer" parent="Cadre/Marges/Colonne/Contenu/Defilement"]
theme_type_variation = &"Mosaique"
size_flags_horizontal = 3

[node name="Zone" type="Node" parent="Cadre/Marges/Colonne/Contenu/Defilement/Jets" node_paths=PackedStringArray("masque")]
script = ExtResource("2_zone")
source = "fenetre.corps"
ids = PackedStringArray("jets/")
masque = NodePath("../..")
