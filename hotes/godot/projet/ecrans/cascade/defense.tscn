[gd_scene load_steps=4 format=3]

[ext_resource type="PackedScene" path="res://cadres/fenetre_de_jet.tscn" id="0_cadre"]
[ext_resource type="Script" path="res://scripts/zone.gd" id="1_zone"]
[ext_resource type="Theme" path="res://art/titre_de_fenetre.tres" id="2_titre"]

[node name="Cadre" instance=ExtResource("0_cadre")]

[node name="Colonne" type="VBoxContainer" parent="."]
theme_type_variation = &"PileSerree"

[node name="Tete" type="HBoxContainer" parent="Colonne"]
theme_type_variation = &"Rangee"

[node name="Titre" type="VBoxContainer" parent="Colonne/Tete"]
size_flags_horizontal = 3
theme = ExtResource("2_titre")

[node name="Zone" type="Node" parent="Colonne/Tete/Titre" node_paths=PackedStringArray("masque")]
script = ExtResource("1_zone")
source = "fenetre.titre"
masque = NodePath("../../../..")

[node name="Etape" type="VBoxContainer" parent="Colonne/Tete"]
size_flags_horizontal = 3
alignment = 1

[node name="Zone" type="Node" parent="Colonne/Tete/Etape"]
script = ExtResource("1_zone")
source = "fenetre.etape"

[node name="Qui" type="VBoxContainer" parent="Colonne"]

[node name="Zone" type="Node" parent="Colonne/Qui"]
script = ExtResource("1_zone")
source = "fenetre.corps"
ids = PackedStringArray("defense/qui")

[node name="Duel" type="HBoxContainer" parent="Colonne"]
theme_type_variation = &"Rangee"

[node name="Reaction" type="VBoxContainer" parent="Colonne/Duel"]
size_flags_horizontal = 3

[node name="Zone" type="Node" parent="Colonne/Duel/Reaction"]
script = ExtResource("1_zone")
source = "fenetre.corps"
ids = PackedStringArray("defense/jet", "jets/0/1")

[node name="Contre" type="VSeparator" parent="Colonne/Duel"]

[node name="Attaque" type="VBoxContainer" parent="Colonne/Duel"]
size_flags_horizontal = 3

[node name="Zone" type="Node" parent="Colonne/Duel/Attaque"]
script = ExtResource("1_zone")
source = "fenetre.corps"
ids = PackedStringArray("jets/0/0")

[node name="Issue" type="VBoxContainer" parent="Colonne"]

[node name="Zone" type="Node" parent="Colonne/Issue"]
script = ExtResource("1_zone")
source = "fenetre.corps"

[node name="Reglages" type="VBoxContainer" parent="Colonne"]

[node name="Zone" type="Node" parent="Colonne/Reglages"]
script = ExtResource("1_zone")
source = "fenetre.reglages"

[node name="Pied" type="HSeparator" parent="Colonne"]

[node name="Gestes" type="HFlowContainer" parent="Colonne"]
alignment = 1

[node name="Zone" type="Node" parent="Colonne/Gestes"]
script = ExtResource("1_zone")
source = "fenetre.gestes"
