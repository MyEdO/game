[gd_scene load_steps=4 format=3]

[ext_resource type="PackedScene" path="res://cadres/monde.tscn" id="1_monde"]
[ext_resource type="Script" path="res://scripts/zone.gd" id="2_zone"]

[sub_resource type="Theme" id="Heure_de_la_nuit"]
Label/font_sizes/font_size = 22

[node name="Monde" instance=ExtResource("1_monde")]

[node name="Paysage" type="PanelContainer" parent="Cadre/Marges/Colonne/Contenu"]
theme_type_variation = &"Paysage"

[node name="Marges" type="MarginContainer" parent="Cadre/Marges/Colonne/Contenu/Paysage"]
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="Scene" type="VBoxContainer" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges"]
theme_override_constants/separation = 16

[node name="Nuit" type="VBoxContainer" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene"]
theme = SubResource("Heure_de_la_nuit")

[node name="Zone" type="Node" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene/Nuit"]
script = ExtResource("2_zone")
source = "fenetre.corps"
ids = PackedStringArray("repos/nuit", "repos/temps", "voyage/heure", "voyage/meteo")

[node name="Route" type="VBoxContainer" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene"]

[node name="Zone" type="Node" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene/Route"]
script = ExtResource("2_zone")
source = "fenetre.corps"
ids = PackedStringArray("voyage/route")

[node name="Frise" type="HFlowContainer" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene"]
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 8

[node name="Zone" type="Node" parent="Cadre/Marges/Colonne/Contenu/Paysage/Marges/Scene/Frise"]
script = ExtResource("2_zone")
source = "fenetre.corps"
ids = PackedStringArray("voyage/etape/")

[node name="Defilement" type="ScrollContainer" parent="Cadre/Marges/Colonne/Contenu"]
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Dormeurs" type="HFlowContainer" parent="Cadre/Marges/Colonne/Contenu/Defilement"]
size_flags_horizontal = 3
theme_override_constants/h_separation = 32
theme_override_constants/v_separation = 12

[node name="Zone" type="Node" parent="Cadre/Marges/Colonne/Contenu/Defilement/Dormeurs"]
script = ExtResource("2_zone")
source = "fenetre.corps"

[node name="Note" type="VBoxContainer" parent="Cadre/Marges/Colonne/Contenu"]

[node name="Zone" type="Node" parent="Cadre/Marges/Colonne/Contenu/Note"]
script = ExtResource("2_zone")
source = "fenetre.corps"
ids = PackedStringArray("repos/note")
