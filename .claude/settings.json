{
  "claudeMdExcludes": ["**/Foundry/CLAUDE.md"],
  "permissions": {
    "allow": ["Bash(npm run:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|mcp__lean-ctx__ctx_patch|Edit|Bash|PowerShell|mcp__lean-ctx__ctx_shell|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hooks/repartiteur.mjs"
            ],
            "timeout": 10,
            "statusMessage": "Gardes des appels d’outil (répartiteur)"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__lean-ctx__ctx_shell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hooks/solde-ticket-hook.mjs"
            ],
            "timeout": 10,
            "statusMessage": "Fermeture de ticket au commit = solde écrit obligatoire"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hooks/repartiteur.mjs"
            ],
            "timeout": 10,
            "statusMessage": "Gardes des appels d’outil (répartiteur)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hooks/bootstrap-conteneur.mjs"
            ],
            "timeout": 300,
            "statusMessage": "Conformité du conteneur distant (hooks git, gh)"
          }
        ]
      }
    ]
  }
}
