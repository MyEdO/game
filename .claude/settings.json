{
  "claudeMdExcludes": ["**/Foundry/CLAUDE.md"],
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(git grep *)",
      "mcp__lean-ctx__ctx_read",
      "mcp__lean-ctx__ctx_search",
      "mcp__lean-ctx__ctx_shell",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__Claude_Browser__find",
      "mcp__lean-ctx__ctx_glob",
      "mcp__plugin_playwright_playwright__browser_console_messages",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_page",
      "mcp__lean-ctx__ctx_tree",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__preview_logs",
      "mcp__ccd_session_mgmt__list_events"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Write|Edit|Bash|PowerShell|mcp__lean-ctx__(?!(?:ctx_read|ctx_smart_read|ctx_multi_read|ctx_search|ctx_semantic_search|ctx_symbol|ctx_glob|ctx_tree|ctx_compose|ctx_overview|ctx_repomap|ctx_outline|ctx_explore|ctx_callgraph|ctx_graph|ctx_impact|ctx_architecture|ctx_routes|ctx_smells|ctx_quality|ctx_review|ctx_expand|ctx_delta|ctx_retrieve|ctx_url_read|ctx_summary|ctx_memory|ctx_cache|ctx_index|ctx_context|ctx_metrics|ctx_gain|ctx_heatmap|ctx_cost|ctx_perf|ctx_compare|ctx_analyze|ctx_benchmark|ctx_discover|ctx_discover_tools|ctx_load_tools|ctx_plan|ctx_fill|ctx_compress|ctx_response)$).+)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hooks/repartiteur.mjs"
            ],
            "timeout": 10,
            "statusMessage": "Gardes des appels d’outil (répartiteur)"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__lean-ctx__ctx_shell|mcp__lean-ctx__shell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hooks/solde-ticket-hook.mjs"
            ],
            "timeout": 10,
            "statusMessage": "Fermeture de ticket au commit = solde écrit obligatoire"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|mcp__lean-ctx__ctx_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hooks/repartiteur.mjs"
            ],
            "timeout": 10,
            "statusMessage": "Gardes des appels d’outil (répartiteur)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hooks/bootstrap-conteneur.mjs"
            ],
            "timeout": 325,
            "statusMessage": "Conformité du conteneur distant (hooks git, docs, gh)"
          }
        ]
      }
    ]
  }
}
