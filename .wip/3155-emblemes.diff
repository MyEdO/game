+    });
+  });
+
+  it('transmet le masquage de l’écu au montage sans en faire un modèle de bouclier rond', () => {
+    const { montage, erreurs } = lireMontage(knight.montage);
+    expect(erreurs).toEqual([]);
+    expect(montage?.masquer).toContain('Badge_Shield');
+    const choisi = premierModele(['rond'], indexDesApparences([manifeste]), { emplacement: 'tenues', main: 'off' });
+    expect(choisi?.composants).toEqual([{ modele: 'Knight.glb', composant: 'bouclier_rond', pieces: ['Round_Shield'] }]);
+  });
+});
