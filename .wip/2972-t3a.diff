diff --git a/src/data/schemas/defs/garde-robe.test.ts b/src/data/schemas/defs/garde-robe.test.ts
new file mode 100644
index 000000000..61e3e956c
--- /dev/null
+++ b/src/data/schemas/defs/garde-robe.test.ts
@@ -0,0 +1,64 @@
+/**
+ * #2972 — la garde-robe au parse : `garde-robe.json` parse, et toute tenue nommée par une carrière, une
+ * espèce de rig ou une apparence d'auteur est une réf `{ id }` d'une tenue EXISTANTE de la garde-robe.
+ */
+import { describe, expect, it } from 'vitest';
+import { schema } from './garde-robe';
+import { schema as schemaCarrieres } from './careers';
+import { schema as schemaRaces } from './raceAppearance';
+import { entityAppearanceSchema } from '../grammaire/valeurs';
+import gardeRobeJson from '../../garde-robe.json';
+import careersJson from '../../careers.json';
+import raceAppearanceJson from '../../raceAppearance.json';
+
+type Entree = { id: string; [k: string]: unknown };
+/** Le document réel, l'entrée `id` modifiée par `champs` (une valeur `undefined` retire la clé). */
+const avec = (json: unknown, id: string, champs: Record<string, unknown>): Entree[] => {
+  const doc = structuredClone(json) as Entree[];
+  const e = doc.find((x) => x.id === id)!;
+  for (const [k, v] of Object.entries(champs)) if (v === undefined) delete e[k]; else e[k] = v;
+  return doc;
+};
+const refus = (r: { success: boolean; error?: { issues: { message: string }[] } }): string => {
+  expect(r.success, 'le document a parsé alors qu’il devait être REFUSÉ').toBe(false);
+  return r.error?.issues.map((i) => i.message).join(' ') ?? '';
+};
+
+describe('garde-robe.json — collection à discriminant `kind` (#2972)', () => {
+  it('le document réel parse', () => {
+    expect(schema.safeParse(gardeRobeJson).success).toBe(true);
+  });
+  it('une sorte hors des sous-listes nommées est refusée', () => {
+    refus(schema.safeParse(avec(gardeRobeJson, 'noble', { kind: 'chapeau' })));
+  });
+});
+
+describe('careers.json › tenue — réf requise d’une tenue de la garde-robe', () => {
+  it('le document réel parse', () => {
+    expect(schemaCarrieres.safeParse(careersJson).success).toBe(true);
+  });
+  it('une tenue inconnue est refusée, nommément', () => {
+    expect(refus(schemaCarrieres.safeParse(avec(careersJson, 'soldat', { tenue: { id: 'manteau-imaginaire' } })))).toMatch(/« manteau-imaginaire » est hors de la sous-liste « tenue » du catalogue des pièces de garde-robe/);
+  });
+  it('un id nu (scalaire) ou une tenue absente est refusé', () => {
+    refus(schemaCarrieres.safeParse(avec(careersJson, 'soldat', { tenue: 'soldat' })));
+    refus(schemaCarrieres.safeParse(avec(careersJson, 'soldat', { tenue: undefined })));
+  });
+});
+
+describe('raceAppearance.json › tenue — réf optionnelle d’une tenue de la garde-robe', () => {
+  it('le document réel parse', () => {
+    expect(schemaRaces.safeParse(raceAppearanceJson).success).toBe(true);
+  });
+  it('une tenue inconnue est refusée, nommément', () => {
