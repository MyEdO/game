+/**
+ * Schéma de `garde-robe.json` — LE vocabulaire de l'apparence portée (#2972), collection à
+ * discriminant `kind` (doctrine `user-direction-fusion-json-par-type`, patron `oups.ts`/`materials.ts`).
+ * Une sous-liste par valeur de `kind`, désignée par la réf `ref('gardeRobe', undefined, '<kind>')` (`grammaire/ref.ts`).
+ *
+ * `tenue` : un habit complet, nommé par une carrière (`careers.json › tenue`), une espèce
+ * (`raceAppearance.json › tenue`) ou une apparence d'auteur (`EntityAppearance.tenue`). Son art vit
+ * au rig (`src/gameIso/rig/parts/tenues/defs/`), keyé par `TenueId`.
+ */
+import { document } from '../grammaire/document';
+import { enumNomme } from '../grammaire/valeurs';
+import type { IdsParEspace } from '../_ids.generated';
+
+export const file = 'garde-robe.json';
+export const famille = 'entite';
+
+/** Les sous-listes de la garde-robe, NOMMÉES : les options de l'enum SONT les clés de cette table. */
+const KINDS = {
+  tenue: 'Tenue',
+} as const;
+
+/** Clés de CHARGE par `kind` : une tenue ne porte que son identité (`id`, `label`). */
+const chargeParDiscriminant: Readonly<Record<keyof typeof KINDS, readonly string[]>> = { tenue: [] };
+
+const doc = document(
+  'garde-robe',
+  famille,
+  {
+    kind: enumNomme(KINDS),
+  },
+  {
+    kind: { label: 'Sorte', hint: 'Sous-liste de la garde-robe' },
+  },
+  {
+    codex: {
+      exempt: {
+        kind: 'vocabulaire-app-interne',
+        raison:
+          'vocabulaire de l’apparence portée (art, pas règle) — aucune catégorie du Codex ne l’expose, aucun écran ne l’écrit : il s’édite au fichier `src/data/garde-robe.json`',
+      },
+    },
+    edit: { none: 'vocabulaire d’art, édité au fichier `src/data/garde-robe.json` — aucun écran ne l’écrit', dataset: 'gardeRobe' },
+  },
+  {
+    espace: { discriminant: 'kind', chargeParDiscriminant },
+  },
+);
+
+export const schema = doc.schema;
+export const meta = doc.meta;
+
+export const exposition = doc.exposition;
+
+/** Id d'une tenue : l'union LITTÉRALE de la sous-liste `kind=tenue` (`npm run gen`). */
+export type TenueId = IdsParEspace['garde-robe.json?kind=tenue'];
+
+/** VUE TS d'une tenue — le nœud rendu par la fabrique est SCELLÉ (`z.infer` y vaut `unknown`). */
+export interface TenueData {
+  id: TenueId;
+  type: 'garde-robe';
+  kind: 'tenue';
+  label: string;
+}
+
+/** VUE TS d'une entrée de la garde-robe. */
+export type GardeRobeEntree = TenueData;
