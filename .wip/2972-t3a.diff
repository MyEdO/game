+/** Sous-liste `kind=tenue` de la garde-robe, relue à chaque version du dataset. */
+export const tenues = memoParVersion('gardeRobe', (): readonly TenueData[] => gardeRobe.filter((e): e is TenueData => e.kind === 'tenue'));
+/** Tenue d'id STABLE, ou `undefined` : l'id n'est aucune tenue. */
+export function findTenueById(id: string | null | undefined): TenueData | undefined {
+  const e = entreeDeGardeRobe(id);
+  return e?.kind === 'tenue' ? e : undefined;
+}
