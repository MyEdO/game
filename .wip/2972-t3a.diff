+import { describe, it, expect } from 'vitest';
+import { CODEX } from './registry';
+import { findTenueById, raceAppearance } from '../../data';
+
+/** Un fait d'en-tête du Codex se lit : une référence `{ id }` s'affiche par le LIBELLÉ de sa cible. */
+describe('Codex — faits d’en-tête lisibles', () => {
+  it('aucun fait n’imprime un objet brut (« [object Object] »)', () => {
+    const bruts = CODEX.flatMap((c) =>
+      c.items.flatMap((i) => (i.meta ?? []).filter((f) => String(f.value).includes('[object')).map((f) => `${c.key}/${i.id} › ${f.label}`)),
+    );
+    expect(bruts).toEqual([]);
+  });
+
+  it('Apparences : la tenue s’affiche par le libellé de la garde-robe', () => {
+    const items = CODEX.find((c) => c.key === 'raceAppearance')!.items;
+    const avecTenue = raceAppearance.filter((r) => r.tenue);
+    expect(avecTenue.length).toBeGreaterThan(0);
+    for (const r of avecTenue) {
+      const tenue = items.find((i) => i.id === r.id)!.meta!.find((f) => f.label === 'Tenue');
+      expect(tenue?.value, r.id).toBe(findTenueById(r.tenue!.id)!.label);
+    }
+  });
+});
