diff --git a/src/ui/editor/codex/TrappingRefField.test.tsx b/src/ui/editor/codex/TrappingRefField.test.tsx
new file mode 100644
index 000000000..133b32842
--- /dev/null
+++ b/src/ui/editor/codex/TrappingRefField.test.tsx
@@ -0,0 +1,113 @@
+// @vitest-environment jsdom
+import { afterEach, beforeAll, describe, expect, it } from 'vitest';
+import { act } from 'react';
+import { TrappingRefField } from './StructFields';
+import type { TrappingRef } from '../../../data';
+import { monterRacine, demonterRacines } from '../../../monterRacine.testkit';
+import { choisirMediaSelect } from '../../MediaSelect.testkit';
+
+beforeAll(() => {
+  (globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+});
+afterEach(demonterRacines);
+
+const DOTATION_DU_CAPITAINE: TrappingRef = {
+  id: 'arme-simple', spec: 'témoin', count: { fixed: 2 },
+  qualities: [{ id: 'raffine' }], qualityChoice: true,
+};
+
+function monterDotation(ref: TrappingRef = DOTATION_DU_CAPITAINE) {
+  let value = structuredClone([ref]);
+  const root = monterRacine(null);
+  const rendre = () => root.rendre(<TrappingRefField value={value} onChange={(next) => { value = next; rendre(); }} />);
+  act(rendre);
+  return { container: root.container, lire: () => value };
+}
+
+function choisirObjet(container: HTMLElement, id: string): void {
+  const champ = container.querySelector<HTMLSelectElement>('select[aria-label="Objet de la possession"]');
+  expect(champ).toBeTruthy();
+  act(() => {
+    champ!.value = id;
+    champ!.dispatchEvent(new Event('change', { bubbles: true }));
+  });
+}
+
+describe('TrappingRefField — apparence de la dotation', () => {
+  it('édite la provenance de la référence et la retire sans toucher la dotation', () => {
+    const h = monterDotation();
+    const livre = h.container.querySelector<HTMLSelectElement>('[aria-label="Livre de la source de la possession"]')!;
+    act(() => { livre.value = 'up-in-arms'; livre.dispatchEvent(new Event('change', { bubbles: true })); });
+    const page = h.container.querySelector<HTMLInputElement>('[aria-label="Page de la source de la possession"]')!;
+    act(() => {
+      Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')!.set!.call(page, '14');
+      page.dispatchEvent(new Event('input', { bubbles: true }));
+      page.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+    act(() => { page.dispatchEvent(new FocusEvent('focusout', { bubbles: true })); });
+    expect(h.lire()).toStrictEqual([{ ...DOTATION_DU_CAPITAINE, source: { book: 'up-in-arms', page: 14 } }]);
+    act(() => { livre.value = ''; livre.dispatchEvent(new Event('change', { bubbles: true })); });
+    expect(h.lire()).toStrictEqual([DOTATION_DU_CAPITAINE]);
+  });
+
+  it('édite une référence typée de véhicule en conservant nom et quantité', () => {
+    const h = monterDotation({ type: 'vehicle', id: 'barque-fluviale', count: { fixed: 2 }, label: 'La Perle' });
+    const selects = h.container.querySelectorAll<HTMLSelectElement>('select');
+    expect(selects[0].value).toBe('vehicle');
+    act(() => { selects[1].value = 'chariot-leger'; selects[1].dispatchEvent(new Event('change', { bubbles: true })); });
+    expect(h.lire()).toStrictEqual([{ type: 'vehicle', id: 'chariot-leger', count: { fixed: 2 }, label: 'La Perle' }]);
+    expect(h.container.querySelector('[title="Apparence de la possession"]')).toBeNull();
+  });
+  it('écrit la variante, conserve le choix explicite de la racine et retire la décision par Automatique', () => {
+    const h = monterDotation();
+    choisirMediaSelect(h.container, 'Apparence de la possession', 'Hache naine');
+    expect(h.lire()).toEqual([{ ...DOTATION_DU_CAPITAINE, apparence: { id: 'hache_naine' } }]);
+    choisirMediaSelect(h.container, 'Apparence de la possession', 'Épée');
+    expect(h.lire()).toEqual([{ ...DOTATION_DU_CAPITAINE, apparence: { id: 'epee' } }]);
+    choisirMediaSelect(h.container, 'Apparence de la possession', 'Automatique');
+    expect(h.lire()).toEqual([DOTATION_DU_CAPITAINE]);
+    expect(h.lire()[0]).not.toHaveProperty('apparence');
+  });
+
+  it('propose les formes et variantes admises par l’objet', () => {
+    const h = monterDotation({ id: 'dague' });
+    const menu = h.container.querySelector('[title="Apparence de la possession"]')!.parentElement!;
+    const labels = [...menu.querySelectorAll('[role="option"] .ms-label')].map((e) => e.textContent);
+    expect(labels).toContain('Dague');
+    expect(labels).not.toContain('Hache naine');
+    expect(labels).not.toContain('Épée');
+  });
+
+  it('garde une apparence encore admise et les autres propriétés lors du changement d’objet', () => {
+    const ref = { ...DOTATION_DU_CAPITAINE, apparence: { id: 'epee' } };
+    const h = monterDotation(ref);
+    choisirObjet(h.container, 'epee-de-retenue');
+    expect(h.lire()).toEqual([{ ...ref, id: 'epee-de-retenue' }]);
+  });
+
+  it('retire seulement l’apparence devenue inadmissible lors du changement d’objet', () => {
+    const h = monterDotation({ ...DOTATION_DU_CAPITAINE, apparence: { id: 'hache_naine' } });
+    choisirObjet(h.container, 'dague');
+    expect(h.lire()).toEqual([{ ...DOTATION_DU_CAPITAINE, id: 'dague' }]);
+    expect(h.lire()[0]).not.toHaveProperty('apparence');
+  });
+
+  it('édite chaque branche d’un choix imbriqué et préserve les autres branches au retrait', () => {
+    const CHOIX_DU_CAPITAINE: TrappingRef = { choice: [DOTATION_DU_CAPITAINE, { choice: [{ id: 'dague' }] }] };
+    const h = monterDotation(CHOIX_DU_CAPITAINE);
+    const branche = (index: number) => {
+      const objet = h.container.querySelectorAll<HTMLSelectElement>('select[aria-label="Objet de la possession"]')[index];
+      const entree = objet.closest('label')!.parentElement!;
+      expect(entree.querySelector(':scope > .fieldrow > [title="Retirer la possession"]')).toBeTruthy();
+      return entree;
+    };
+    choisirMediaSelect(branche(0), 'Apparence de la possession', 'Hache naine');
+    choisirMediaSelect(branche(1), 'Apparence de la possession', 'Dague');
+    const autreBranche = { choice: [{ id: 'dague', apparence: { id: 'dague' } }] };
+    expect(h.lire()).toEqual([{ choice: [{ ...DOTATION_DU_CAPITAINE, apparence: { id: 'hache_naine' } }, autreBranche] }]);
+    choisirMediaSelect(branche(0), 'Apparence de la possession', 'Automatique');
+    expect(h.lire()).toEqual([{ choice: [DOTATION_DU_CAPITAINE, autreBranche] }]);
+    act(() => branche(0).querySelector<HTMLButtonElement>('[title="Retirer la possession"]')!.click());
+    expect(h.lire()).toEqual([{ choice: [autreBranche] }]);
+  });
+});
