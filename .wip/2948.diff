+import { z } from 'zod';
+import { nommerNoeud } from './meta.ts';
+import { ref, refs, refTypee } from './ref.ts';
+import { countSpecSchema, enumNomme, sourceRefSchema, validerApparenceDObjet } from './valeurs.ts';
+
+/** #1463#issuecomment-5385520833 ; #2948#issuecomment-6389403247 */
+export const dotationConcreteSchema = refTypee(enumNomme({ trapping: 'Objet', creature: 'Créature', vehicle: 'Véhicule' }), {
+  trapping: {
+    champs: {
+      spec: nommerNoeud(z.string().optional(), { nom: 'spécialisation' }),
+      count: nommerNoeud(countSpecSchema.optional(), { nom: 'nombre' }),
+      qualities: nommerNoeud(z.union([z.literal(true), refs('quality')]).optional(), { nom: 'qualités' }),
+      apparence: nommerNoeud(ref('apparence').optional(), { nom: 'apparence' }),
+      source: nommerNoeud(sourceRefSchema.optional(), { nom: 'source' }),
+    },
+    verifier: (v, ctx) => {
+      const apparence = v.apparence as { id: string } | undefined;
+      if (apparence) validerApparenceDObjet(String(v.id), apparence.id, ctx, ['apparence', 'id']);
+    },
+  },
+  creature: {
+    champs: {
+      count: nommerNoeud(countSpecSchema.optional(), { nom: 'nombre' }),
+      label: nommerNoeud(z.string().optional(), { nom: 'libellé' }),
+    },
+  },
+  vehicle: {
+    champs: {
+      count: nommerNoeud(countSpecSchema.optional(), { nom: 'nombre' }),
+      label: nommerNoeud(z.string().optional(), { nom: 'libellé' }),
+    },
+  },
+});
