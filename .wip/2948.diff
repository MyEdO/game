--- /dev/null
+++ b/src/data/schemas/grammaire/ref-typee-compositions.test.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it } from 'vitest';
+import { z } from 'zod';
+import { dotationConcreteSchema } from './dotation';
+import { declarationDeRefTypee, mesureDuParse, ref, refTypee } from './ref';
+import { enumNomme } from './valeurs';
+import { nommerNoeud } from './meta';
+import { IDS_PAR_ESPACE } from '../_ids.generated';
+
+const OBJET = { type: 'trapping', id: 'arme-simple', qualities: true };
+const branche = (type: 'trapping') => declarationDeRefTypee(dotationConcreteSchema)!.branches.get(type)!;
+
+describe('composition nominale de référence typée', () => {
+  it('chaque branche porte sa charge fermée, sans emprunter les clés des autres branches', () => {
+    expect(dotationConcreteSchema.safeParse(OBJET).success).toBe(true);
+    expect(dotationConcreteSchema.safeParse({ type: 'vehicle', id: IDS_PAR_ESPACE['vehicles.json'][0], label: 'Barque', count: { fixed: 2 } }).success).toBe(true);
+    expect(dotationConcreteSchema.safeParse({ type: 'creature', id: IDS_PAR_ESPACE['creatures.json'][0], count: { fixed: 2 } }).success).toBe(true);
+    expect(dotationConcreteSchema.safeParse({ ...OBJET, cleEtrangere: true }).success).toBe(false);
+    expect(dotationConcreteSchema.safeParse({ type: 'vehicle', id: IDS_PAR_ESPACE['vehicles.json'][0], qualities: true }).success).toBe(false);
+    expect(dotationConcreteSchema.safeParse({ ...OBJET, qualities: ['solide'] }).success).toBe(true);
+    expect(dotationConcreteSchema.safeParse({ ...OBJET, qualities: [{ id: 'solide', value: 1 }] }).success).toBe(false);
+  });
+
+  it('la déclaration rend les nœuds fermés qui valident réellement chaque branche', () => {
+    const mesure = mesureDuParse(z.array(dotationConcreteSchema), [OBJET]);
+    expect(mesure.compositions).toHaveLength(1);
+    expect(mesure.compositions[0].path).toEqual([0]);
+    expect(mesure.compositions[0].noeud).toBe(dotationConcreteSchema);
+    expect(mesure.compositions[0].branche).toBe(branche('trapping'));
+  });
+
+  it('une copie de forme et un clone Zod ne deviennent pas le nœud nominal déclaré', () => {
+    const copie = z.strictObject({ ...branche('trapping').shape });
+    expect(copie.safeParse(OBJET).success).toBe(true);
+    expect(declarationDeRefTypee(copie)).toBeUndefined();
+    expect(mesureDuParse(copie, OBJET).compositions).toEqual([]);
+    const clone = dotationConcreteSchema.clone();
+    expect(clone.safeParse(OBJET).success).toBe(true);
+    expect(declarationDeRefTypee(clone)).toBeUndefined();
+    expect(mesureDuParse(clone, OBJET).compositions).toEqual([]);
+  });
+
+  it('une branche rejetée ne déclare pas la composition acceptée par une autre branche', () => {
+    const schema = z.union([dotationConcreteSchema, z.looseObject({ type: z.string(), id: z.string() })]);
+    const valeur = { ...OBJET, cleEtrangere: true };
+    expect(schema.safeParse(valeur).success).toBe(true);
+    expect(mesureDuParse(schema, valeur).compositions).toEqual([]);
+    const rejetee = refTypee(enumNomme({ trapping: 'Objet' }), {
+      trapping: {
+        champs: { qualities: nommerNoeud(z.literal(true), { nom: 'qualités' }) },
+        verifier: (_valeur, ctx) => ctx.addIssue({ code: 'custom', message: 'rejet du témoin', continue: true }),
+      },
+    });
+    const repli = ref('trapping', {
+      type: nommerNoeud(z.literal('trapping'), { nom: 'type' }),
+      qualities: nommerNoeud(z.literal(true), { nom: 'qualités' }),
+    });
+    const union = z.union([rejetee, repli]);
+    expect(union.safeParse(OBJET).success).toBe(true);
+    const mesure = mesureDuParse(union, OBJET);
+    expect(mesure.reperes.map(({ path, type }) => ({ path, type }))).toEqual([{ path: ['id'], type: 'trapping' }]);
+    expect(mesure.compositions).toEqual([]);
+  });
+
+  it('un parse imbriqué qui reporte ses issues conserve les identités nominales validées', () => {
+    const relais = z.unknown().superRefine((valeur, ctx) => {
+      const resultat = dotationConcreteSchema.safeParse(valeur);
+      if (!resultat.success) for (const issue of resultat.error.issues) ctx.addIssue({ ...issue, message: issue.message });
+    });
+    const compositions = mesureDuParse(relais, OBJET).compositions;
+    expect(compositions).toHaveLength(1);
+    expect(compositions[0].noeud).toBe(dotationConcreteSchema);
+    expect(compositions[0].branche).toBe(branche('trapping'));
+  });
+
+  it('une composition ne se propage ni au parent ni à ses autres enfants', () => {
+    const schema = z.strictObject({ dotation: dotationConcreteSchema, instance: z.strictObject({ uid: z.string(), trappingId: z.string(), qualities: z.array(z.string()) }) });
+    const mesure = mesureDuParse(schema, { dotation: OBJET, instance: { uid: 'instance', trappingId: 'arme-simple', qualities: ['solide'] } });
+    expect(mesure.compositions.map((c) => c.path)).toEqual([['dotation']]);
+  });
+
+  it('une nouvelle charge se déclare au schéma et reste fermée sans vocabulaire global de clés', () => {
+    const schema = refTypee(enumNomme({ skill: 'Compétence' }), { skill: { champs: { condition: nommerNoeud(z.boolean().optional(), { nom: 'condition' }) } } });
+    const valeur = { type: 'skill', id: IDS_PAR_ESPACE['skills.json'][0], condition: true };
+    expect(schema.safeParse(valeur).success).toBe(true);
+    expect(schema.safeParse({ ...valeur, etrangere: true }).success).toBe(false);
+    expect(mesureDuParse(schema, valeur).compositions[0].noeud).toBe(schema);
+    expect(Object.keys(declarationDeRefTypee(schema)!.branches.get('skill')!.shape).sort()).toEqual(['condition', 'id', 'type']);
+  });
+});
