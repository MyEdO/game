+import { describe, expect, it } from 'vitest';
+import { z } from 'zod';
+import { dotationConcreteSchema } from './schemas/grammaire/dotation';
+import { declarationDeRefTypee, idDe } from './schemas/grammaire/ref';
+import type { SchemaDef } from './schemas/types';
+import { scannerFixtureDeReferences } from '../../scripts/docs/lib/structures-fixture.testkit.mts';
+
+const CATALOGUE = [{ id: 'arme-simple', label: 'Arme simple' }];
+const DOTATION = { type: 'trapping', id: 'arme-simple', qualities: true, apparence: { id: 'epee' }, source: { book: 'aux-armes', page: 14 } };
+const copie = () => z.strictObject({ ...declarationDeRefTypee(dotationConcreteSchema)!.branches.get('trapping')!.shape });
+function scanner(nom: string, schema: z.ZodType, entries: unknown[]) {
+  const defs: SchemaDef[] = [
+    { file: 'trappings.json', root: 'src/data', famille: 'entite', schema: z.array(z.strictObject({ id: z.string(), label: z.string() })) },
+    { file: 'careerLevels.json', root: 'src/data', famille: 'entite', schema: z.array(schema) },
+  ];
+  return scannerFixtureDeReferences(nom, { 'trappings.json': CATALOGUE, 'careerLevels.json': entries }, defs);
+}
+const formesDeDotation = (scan: ReturnType<typeof scanner>) => scan.formes.filter((f) => f.concept === 'reference' && f.dataset === 'careerLevels.json' && f.champ === 'trappings');
+
+describe('cible de composition — qualification par le schéma réel du site', () => {
+  it('la dotation concrète validée est cible, sans déclarer sa signature libre globalement', () => {
+    const mesure = scanner('dotation-concrete-nominale-', z.strictObject({ id: z.string(), trappings: z.array(dotationConcreteSchema) }), [{ id: 'canon', trappings: [DOTATION] }]);
+    expect(formesDeDotation(mesure), JSON.stringify(mesure.formes)).toEqual([expect.objectContaining({ statut: 'cible', occurrences: 1 })]);
+  });
+
+  it('une copie structurelle ne peut pas emprunter la cible, même au même champ et à signature identique', () => {
+    const schema = z.discriminatedUnion('kind', [
+      z.strictObject({ id: z.string(), kind: z.literal('canon'), trappings: z.array(dotationConcreteSchema) }),
+      z.strictObject({ id: z.string(), kind: z.literal('copie'), trappings: z.array(copie()) }),
+    ]);
+    const mesure = scanner('dotation-cible-et-copie-', schema, [{ id: 'canon', kind: 'canon', trappings: [DOTATION] }, { id: 'copie', kind: 'copie', trappings: [DOTATION] }]);
+    const formes = formesDeDotation(mesure);
+    expect(formes.filter((f) => f.statut === 'cible').map((f) => f.occurrences)).toEqual([1]);
+    expect(formes.filter((f) => f.statut !== 'cible').map((f) => f.occurrences)).toEqual([1]);
+  });
+
+  it('un clone Zod et une branche rejetée restent hors de la cible', () => {
+    const schema = z.strictObject({ id: z.string(), trappings: z.array(z.union([dotationConcreteSchema, z.looseObject({ type: z.string(), id: idDe('trapping') })])) });
+    const mesure = scanner('dotation-branche-rejetee-', schema, [{ id: 'rejetee', trappings: [{ ...DOTATION, apparence: { id: 'zweihander' } }] }]);
+    expect(formesDeDotation(mesure).filter((f) => f.statut === 'cible')).toEqual([]);
+    const clone = scanner('dotation-clone-zod-', z.strictObject({ id: z.string(), trappings: z.array(dotationConcreteSchema.clone()) }), [{ id: 'clone', trappings: [DOTATION] }]);
+    expect(formesDeDotation(clone).filter((f) => f.statut === 'cible')).toEqual([]);
+  });
+
+  it('un choix garde sa forme historique et son enfant concret garde sa qualification propre', () => {
+    const schema = z.strictObject({ id: z.string(), trappings: z.array(z.union([z.strictObject({ choice: z.array(dotationConcreteSchema) }), z.strictObject({ id: z.string() })])) });
+    const mesure = scanner('dotation-concrete-sous-choix-', schema, [{ id: 'choix', trappings: [{ choice: [DOTATION] }, { id: 'arme-simple' }, { id: 'arme-simple' }] }]);
+    expect(mesure.formes.filter((f) => f.concept === 'reference' && f.signature === 'choice'), JSON.stringify(mesure.formes)).toEqual([expect.objectContaining({ statut: 'historique', occurrences: 1 })]);
+    expect(mesure.formes.filter((f) => f.concept === 'reference' && f.champ === 'choice' && f.statut === 'cible')).toEqual([expect.objectContaining({ occurrences: 1 })]);
+  });
+
+  it('une instance reste mesurée sans recevoir la cible de la dotation voisine', () => {
+    const schema = z.strictObject({ id: z.string(), trappings: z.array(dotationConcreteSchema), instances: z.array(z.strictObject({ uid: z.string(), trappingId: z.string(), qualities: z.array(z.string()) })) });
+    const mesure = scanner('dotation-instance-voisine-', schema, [{ id: 'porteur', trappings: [DOTATION], instances: [{ uid: 'instance', trappingId: 'arme-simple', qualities: ['solide'] }] }]);
+    expect(formesDeDotation(mesure), JSON.stringify(mesure.formes)).toEqual([expect.objectContaining({ statut: 'cible', occurrences: 1 })]);
+    expect(mesure.formes.filter((f) => f.champ === 'instances' && f.statut === 'cible')).toEqual([]);
+  });
+});
