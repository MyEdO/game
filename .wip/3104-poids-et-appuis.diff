+def refus():
+    x = np.array([[0, 0, 0, 1], [1, 0, 0, 1], [2, 0, 0, 1], [3, 0, 0, 1]], dtype=np.float32)
+    w = np.array([[1, 0], [1, 0], [1, 0], [0, 1]], dtype=np.float32)
