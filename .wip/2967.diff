+import { describe, expect, it } from 'vitest';
+import { qualities } from '../data';
+import { setDataset } from '../data/overrides';
+import { createHero } from './character';
+import { ignoredArmourAP, recomputeLoadout, wornArmourPoints } from './items';
+import { objetDeTest } from './objetsDeTest.testkit';
+import type { ItemInstance } from './types';
+
+function avecPointsFaibles(id: 'solide' | 'points-faibles', capacite: boolean | undefined, verifier: () => void): void {
+  const origine = [...qualities];
+  const fixture = origine.map((qualite) => {
+    if (qualite.id === 'flexible') return { ...qualite, capabilities: { ...qualite.capabilities, layerable: true, apIgnoredOnImpaleCrit: false } };
+    if (qualite.id !== id) return qualite;
+    const capabilities = { ...qualite.capabilities };
+    if (capacite === undefined) delete capabilities.apIgnoredOnImpaleCrit;
+    else capabilities.apIgnoredOnImpaleCrit = capacite;
+    return { ...qualite, capabilities };
+  });
+  try {
+    setDataset('qualities', fixture);
+    verifier();
+  } finally {
+    setDataset('qualities', origine);
+  }
+}
+
+function porteur(pieces: ItemInstance[]) {
+  const acteur = createHero({ speciesId: 'humains-reiklander', careerId: 'garde', label: 'Porteur de test', seed: 1 });
+  acteur.items = pieces;
+  recomputeLoadout(acteur);
+  return acteur;
+}
+
+function plate(qualite: 'solide' | 'points-faibles') {
+  const armure = objetDeTest('plastron', { uid: 'plate', equipped: true });
+  armure.qualities = [{ id: qualite }];
+  return armure;
+}
+
+/** LDB 63 l.90 ; CRB 087 l.52 */
+describe('weakpoints : PA ignorés sur Critique Empaleuse', () => {
+  it('une autre qualité portant la capacité ignore les PA de sa pièce', () => {
+    avecPointsFaibles('solide', true, () => {
+      const armure = plate('solide');
+      const acteur = porteur([armure]);
+      expect(ignoredArmourAP(acteur, 'corps', { roll: 11, critical: true, empaleuse: true })).toBe(armure.pa);
+    });
+  });
+
+  it.each([
+    { critical: false, empaleuse: true },
+    { critical: true, empaleuse: false },
+  ])('le Critique et Empaleuse sont tous deux requis : %j', (hit) => {
+    avecPointsFaibles('solide', true, () => {
+      const acteur = porteur([plate('solide')]);
+      expect(ignoredArmourAP(acteur, 'corps', { roll: 11, ...hit })).toBe(0);
+    });
+  });
+
+  it.each([false, undefined])('Points faibles sans capacité active %s ne remplace pas la donnée', (capacite) => {
+    avecPointsFaibles('points-faibles', capacite, () => {
+      const acteur = porteur([plate('points-faibles')]);
+      expect(ignoredArmourAP(acteur, 'corps', { roll: 11, critical: true, empaleuse: true })).toBe(0);
+    });
+  });
+
+  /** LDB 63 l.74, l.90 ; CRB 087 l.26, l.52 */
+  it('la couche Flexible non affectée conserve ses PA sous la pièce ignorée', () => {
+    avecPointsFaibles('solide', true, () => {
+      const dessus = plate('solide');
+      const dessous = objetDeTest('chemise-de-mailles', { uid: 'maille', equipped: true });
+      dessous.qualities = [{ id: 'flexible' }];
+      const acteur = porteur([dessous, dessus]);
+      const ignores = ignoredArmourAP(acteur, 'corps', { roll: 11, critical: true, empaleuse: true });
+      expect(ignores).toBe(dessus.pa);
+      expect(wornArmourPoints(acteur.items!).corps - ignores).toBe(dessous.pa);
+    });
+  });
+});
