+const type = 'export interface Caps { active?: boolean; other?: boolean }';
+const mesurer = (fixtures: Record<string, string>) => {
+  const programme = virtualProgram(fixtures);
+  const cache = new Map();
+  const files = Object.keys(fixtures).map(file => join(VIRTUAL_ROOT, file));
+  try {
+    return {
+      direct: scanRuntimeFieldReads(cible, ['active', 'other'], files, VIRTUAL_ROOT, cache, programme),
+      dynamic: scanDynamicFieldCalls(cible, ['active', 'other'], files, VIRTUAL_ROOT, cache, programme),
