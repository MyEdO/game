--- /dev/null
+++ b/src/engine/layerable-capability.test.ts
@@ -0,0 +1,60 @@
+import { describe, expect, it } from 'vitest';
+import { qualities } from '../data';
+import { setDataset } from '../data/overrides';
+import { objetDeTest } from './objetsDeTest.testkit';
+import { armourLayer, wornArmourPoints } from './items';
+import { isLayerable } from './qualities/dispatch';
+
+function avecSuperposition(id: string, layerable: boolean | undefined, verifier: () => void): void {
+  const origine = [...qualities];
+  const fixture = origine.map((qualite) => {
+    if (qualite.id !== id) return qualite;
+    const capabilities = { ...qualite.capabilities };
+    if (layerable === undefined) delete capabilities.layerable;
+    else capabilities.layerable = layerable;
+    return { ...qualite, capabilities };
+  });
+  try {
+    setDataset('qualities', fixture);
+    verifier();
+  } finally {
+    setDataset('qualities', origine);
+  }
+}
+
+function armuresPortees(qualite: 'solide' | 'flexible') {
+  const dessous = objetDeTest('chemise-de-mailles', { uid: 'dessous', equipped: true });
+  dessous.qualities = [{ id: qualite }];
+  const dessus = objetDeTest('plastron', { uid: 'dessus', equipped: true });
+  return { dessous, dessus };
+}
+
+/** LDB 63 l.74 ; CRB 087 l.26 */
+describe('layerable : superposition déclarée par la qualité', () => {
+  it('une qualité éditée au Codex permet de cumuler les deux armures', () => {
+    avecSuperposition('solide', true, () => {
+      const { dessous, dessus } = armuresPortees('solide');
+      expect(isLayerable(dessous)).toBe(true);
+      expect(armourLayer(dessous)).toBe('flexible');
+      expect(wornArmourPoints([dessous, dessus]).corps).toBe(dessous.pa! + dessus.pa!);
+    });
+  });
+
+  it.each([false, undefined])('une capacité %s ne permet pas de superposition', (layerable) => {
+    avecSuperposition('solide', layerable, () => {
+      const { dessous, dessus } = armuresPortees('solide');
+      expect(isLayerable(dessous)).toBe(false);
+      expect(armourLayer(dessous)).toBe('rigide');
+      expect(wornArmourPoints([dessous, dessus]).corps).toBe(Math.max(dessous.pa!, dessus.pa!));
+    });
+  });
+
+  it.each([false, undefined])('le nom Flexible ne remplace pas une capacité %s', (layerable) => {
+    avecSuperposition('flexible', layerable, () => {
+      const { dessous, dessus } = armuresPortees('flexible');
+      expect(isLayerable(dessous)).toBe(false);
+      expect(armourLayer(dessous)).toBe('rigide');
+      expect(wornArmourPoints([dessous, dessus]).corps).toBe(Math.max(dessous.pa!, dessus.pa!));
+    });
+  });
+});
