diff --git a/src/state/damages-armour-capability.test.ts b/src/state/damages-armour-capability.test.ts
new file mode 100644
index 000000000..2912b9eb2
--- /dev/null
+++ b/src/state/damages-armour-capability.test.ts
@@ -0,0 +1,86 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { qualities } from '../data';
+import { setDataset } from '../data/overrides';
+import { createHero } from '../engine/character';
+import { resolveMelee } from '../engine/combat';
+import { deFixe } from '../engine/dice.testkit';
+import { recomputeLoadout } from '../engine/items';
+import { armeDeTest, objetDeTest } from '../engine/objetsDeTest.testkit';
+import { applyAttackResult } from '../noyau/combatFlow';
+import { testScene } from '../scenes/test-fixture';
+import { draineCascade } from './cascade.testkit';
+import { useGame } from './store';
+
+let origine: typeof qualities;
+
+beforeEach(() => {
+  origine = [...qualities];
+  vi.useFakeTimers();
+});
+
+afterEach(() => {
+  setDataset('qualities', origine);
+  vi.clearAllTimers();
+  vi.useRealTimers();
+});
+
+function jouerCoup(qualite: 'solide' | 'taille', capacite: boolean | undefined, face: number) {
+  setDataset('qualities', origine.map((entree) => {
+    if (entree.id !== qualite) return entree;
+    const capabilities = { ...entree.capabilities };
+    if (capacite === undefined) delete capabilities.damagesArmour;
+    else capabilities.damagesArmour = capacite;
+    return { ...entree, capabilities };
+  }));
+  const hero = createHero({ speciesId: 'humains-reiklander', careerId: 'soldat', label: 'Frappeur de test', seed: 7 });
+  useGame.setState({ party: [hero], battle: null, pendingCascade: null, suspendedCascades: [], net: { ...useGame.getState().net, mode: 'local', mySeat: 0, gmSeat: undefined } });
+  useGame.getState().startScene(structuredClone(testScene()));
+  useGame.getState().startCombat('enc-mutants');
+  useGame.getState().confirmRoundStart();
+  vi.clearAllTimers();
+  const bataille = useGame.getState().battle!;
+  const attaquant = bataille.combatants.find((acteur) => acteur.kind === 'hero')!;
+  const cible = bataille.combatants.find((acteur) => acteur.kind === 'enemy')!;
+  const piece = objetDeTest('plastron', { uid: 'plastron-frappe', equipped: true });
+  cible.items = [piece];
+  recomputeLoadout(cible);
+  cible.wounds = { current: 100, max: 100 };
+  cible.important = true;
+  attaquant.characteristics['capacite-de-combat'] = 90;
+  const arme = armeDeTest('dague', { uid: 'arme-frappe' });
+  arme.qualities = [{ id: qualite }];
+  attaquant.weapons = [arme];
+  const resultat = resolveMelee(attaquant, cible, arme, deFixe(face), { defense: 'none', location: 'corps' });
+  expect(resultat.critical).toBeFalsy();
+  const avant = { dommage: piece.damageTaken ?? 0, blessures: cible.wounds.current };
+  applyAttackResult(useGame.getState, useGame.setState, attaquant, cible, arme, resultat);
+  draineCascade(useGame.getState, 200, () => 1, (etape) => etape.options?.some((option) => option.key === 'subir') ? 'subir' : undefined);
+  const apres = useGame.getState().battle!.combatants.find((acteur) => acteur.id === cible.id)!;
+  const pieceApres = apres.items!.find((objet) => objet.uid === piece.uid)!;
+  return { resultat, avant, apres, pieceApres };
+}
+
+/** LDB 62 l.307 */
+describe('damagesArmour : dommage à la pièce frappée par le chemin de combat', () => {
+  it('une qualité portant la capacité endommage une fois la pièce frappée sur une touche', () => {
+    const { resultat, avant, apres, pieceApres } = jouerCoup('solide', true, 7);
+    expect(resultat.hit).toBe(true);
+    expect(resultat.location).toBe('corps');
+    expect(pieceApres.damageTaken ?? 0).toBe(avant.dommage + 1);
+    expect(apres.wounds.current).toBeLessThan(avant.blessures);
+  });
+
+  it.each([false, undefined])('Taille sans capacité active %s ne cause aucun dommage à la pièce', (capacite) => {
+    const { resultat, avant, apres, pieceApres } = jouerCoup('taille', capacite, 7);
+    expect(resultat.hit).toBe(true);
+    expect(pieceApres.damageTaken ?? 0).toBe(avant.dommage);
+    expect(apres.wounds.current).toBeLessThan(avant.blessures);
+  });
+
+  it('une qualité portant la capacité ne cause aucun dommage sur un raté', () => {
+    const { resultat, avant, apres, pieceApres } = jouerCoup('solide', true, 97);
+    expect(resultat.hit).toBe(false);
+    expect(pieceApres.damageTaken ?? 0).toBe(avant.dommage);
+    expect(apres.wounds.current).toBe(avant.blessures);
+  });
+});
