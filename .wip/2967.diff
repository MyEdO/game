+describe('consommateurs de capacités — identité typée et clés d’appel', () => {
+  it('suit un alias et trois paramètres jusqu’à la clé littérale du geste runtime', () => {
+    const result = mesurer({
+      'src/data/types.ts': type,
+      'src/engine/getter.ts': `import type { Caps } from '../data/types';
+export function read(c: Caps, key: keyof Caps) { return c[key]; }
+export const alias = read;
+`,
+      'src/engine/action.ts': `import type { Caps } from '../data/types';
+import { alias } from './getter';
