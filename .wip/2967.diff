+import { describe, expect, it } from 'vitest';
+import { createHero } from './character';
+import { objetDeTest } from './objetsDeTest.testkit';
+import { skillToolMod } from './skills';
+
+function crocheteur() {
+  const heros = createHero({ speciesId: 'humains-reiklander', careerId: 'voleur', label: 'Crocheteur', seed: 1 });
+  heros.items = [];
+  return heros;
+}
+
+/** LDB 67 l.66 ; CRB 091 l.15 */
+describe('lockpicks : outils de crochetage dans le sac', () => {
+  it('les outils non équipés permettent de crocheter sans pénalité', () => {
+    const heros = crocheteur();
+    heros.items = [objetDeTest('outils-de-crochetage', { uid: 'outils', equipped: false })];
+    expect(skillToolMod(heros, 'crochetage')).toBe(0);
+  });
+
+  /** LDB 09 l.168 */
+  it('sans outils, le malus de crochetage est appliqué', () => {
+    expect(skillToolMod(crocheteur(), 'crochetage')).toBe(-10);
+  });
+
+  /** LDB 09 l.168 */
+  it('des outils détruits ne permettent pas de crocheter sans pénalité', () => {
+    const heros = crocheteur();
+    const outils = objetDeTest('outils-de-crochetage', { uid: 'outils', equipped: false });
+    outils.destroyed = true;
+    heros.items = [outils];
+    expect(skillToolMod(heros, 'crochetage')).toBe(-10);
+  });
+});
