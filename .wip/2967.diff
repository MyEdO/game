+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { qualities } from '../data';
+import { setDataset } from '../data/overrides';
+import { createHero } from './character';
+import { ignoredArmourAP, recomputeLoadout, wornArmourPoints } from './items';
+import { objetDeTest } from './objetsDeTest.testkit';
+
+let origine: typeof qualities;
+
+beforeEach(() => {
+  origine = [...qualities];
+  const fixture = origine.map((qualite) => {
+    const capabilities = { ...qualite.capabilities, apIgnoredOnImpaleCrit: false };
+    if (qualite.id === 'solide') capabilities.apIgnoredOnEven = true;
+    if (qualite.id === 'partielle') capabilities.apIgnoredOnEven = false;
+    if (qualite.id === 'flexible') {
+      delete capabilities.apIgnoredOnEven;
+      capabilities.layerable = true;
+    }
+    return { ...qualite, capabilities };
+  });
+  setDataset('qualities', fixture);
+});
+
+afterEach(() => {
+  setDataset('qualities', origine);
+});
+
+function porteur(qualite: 'solide' | 'partielle' | 'flexible') {
+  const piece = objetDeTest('plastron', { uid: 'piece', equipped: true });
+  piece.qualities = [{ id: qualite }];
+  const acteur = createHero({ speciesId: 'humains-reiklander', careerId: 'garde', label: 'Porteur partiel de test', seed: 1 });
+  acteur.items = [piece];
+  recomputeLoadout(acteur);
+  return { acteur, piece };
+}
+
+/** LDB 63 l.86 */
+describe('partial : PA ignorés par la capacité de la pièce', () => {
+  it('une qualité portant la capacité ignore ses PA sur une attaque paire', () => {
+    const { acteur, piece } = porteur('solide');
+    expect(ignoredArmourAP(acteur, 'corps', { roll: 12, critical: false, empaleuse: false })).toBe(piece.pa);
+  });
+
+  it('une attaque impaire sans Critique conserve les PA', () => {
+    const { acteur } = porteur('solide');
+    expect(ignoredArmourAP(acteur, 'corps', { roll: 11, critical: false, empaleuse: false })).toBe(0);
+  });
+
+  it('un Critique impair ignore les PA de la pièce portant la capacité', () => {
+    const { acteur, piece } = porteur('solide');
+    expect(ignoredArmourAP(acteur, 'corps', { roll: 11, critical: true, empaleuse: false })).toBe(piece.pa);
+  });
+
+  it.each([false, undefined])('une capacité %s sur Partielle conserve les PA', (capacite) => {
+    setDataset('qualities', qualities.map((qualite) => {
+      if (qualite.id !== 'partielle') return qualite;
+      const capabilities = { ...qualite.capabilities };
+      if (capacite === undefined) delete capabilities.apIgnoredOnEven;
+      else capabilities.apIgnoredOnEven = capacite;
+      return { ...qualite, capabilities };
+    }));
+    const { acteur } = porteur('partielle');
+    expect(ignoredArmourAP(acteur, 'corps', { roll: 12, critical: true, empaleuse: false })).toBe(0);
+  });
+
+  it('une qualité sans la capacité conserve les PA', () => {
+    const { acteur } = porteur('flexible');
+    expect(ignoredArmourAP(acteur, 'corps', { roll: 12, critical: true, empaleuse: false })).toBe(0);
+  });
