diff --git a/scripts/raw/chemins-livres.test.mjs b/scripts/raw/chemins-livres.test.mjs
new file mode 100644
index 000000000..dbdbd0f8b
--- /dev/null
+++ b/scripts/raw/chemins-livres.test.mjs
@@ -0,0 +1,80 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { isAbsolute, join, relative, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { spawnSync } from 'node:child_process'
+import { chapterFile, cheminDuDepot, creerDossierDuDepot, ecrireTexteDuDepot, folioIndexOf, listerDossierDuDepot, listerArbreDuDepot, readText, REGISTRE_LIVRES } from './_lib.mjs'
+import { listerDossier } from '../guards/lib/lister.mjs'
+import { numeroDuFichier } from '../../src/data/source/decoupe.ts'
+import { makeChapterReader } from '../guards/lib/folioLineAlign.mjs'
+import { chapitresDe, lireChapitre } from '../source/lecteur-fs.mjs'
+
+const racine = fileURLToPath(new URL('../../', import.meta.url))
+
+if (process.argv.includes('--lecture-etrangere')) {
+  const etranger = process.cwd()
+  const cache = resolve(racine, 'node_modules/.cache')
+  mkdirSync(cache, { recursive: true })
+  const fixture = mkdtempSync(join(cache, '3120-couture-'))
+  try {
+    const dossier = relative(racine, fixture)
+    const fichier = join(dossier, 'chapitre.md')
+    const leurre = resolve(etranger, fichier)
+    mkdirSync(resolve(leurre, '..'), { recursive: true })
+    writeFileSync(leurre, 'leurre\n')
+    creerDossierDuDepot(join(dossier, 'chapitres'))
+    ecrireTexteDuDepot(fichier, 'chapitre\r\n')
+    assert.equal(readText(fichier), 'chapitre\n')
+    assert.equal(readFileSync(resolve(racine, fichier), 'utf8'), 'chapitre\r\n')
+    assert.equal(readFileSync(leurre, 'utf8'), 'leurre\n')
+    assert.deepEqual(listerDossierDuDepot(dossier).sort(), ['chapitre.md', 'chapitres'])
+    assert.deepEqual(listerArbreDuDepot(dossier), ['chapitre.md'])
+  } finally {
+    rmSync(fixture, { recursive: true, force: true })
+  }
+  const livre = REGISTRE_LIVRES.find((b) => b.dir && b.coeur)
+  assert.ok(livre)
+  const fichier = listerDossier(resolve(racine, livre.dir)).find((f) => numeroDuFichier(f) != null && /data-folio="/.test(readText(resolve(racine, livre.dir, f))))
+  assert.ok(fichier, 'un chapitre réel avec ancres de folios')
+  const ch = numeroDuFichier(fichier)
+  const lecteur = makeChapterReader(REGISTRE_LIVRES)
+  let premier
+  let premiersFolios
+  for (const cwd of [etranger, racine, etranger]) {
+    process.chdir(cwd)
+    const chapitre = chapterFile(livre.abbr, ch)
+    assert.ok(chapitre, `chapitre absent depuis ${cwd}`)
+    assert.equal(chapitre.dir, livre.dir)
+    assert.equal(chapitre.path, join(livre.dir, fichier))
+    assert.equal(isAbsolute(chapitre.path), false)
+    const texte = readText(chapitre.path)
+    assert.ok(texte.trim())
+    const folios = folioIndexOf(livre.abbr)
+    assert.ok(folios.size > 0)
+    assert.deepEqual(lecteur(livre.abbr, ch), texte.split('\n'))
+    assert.ok(chapitresDe(livre.id).some((n) => Number(n) === ch))
+    assert.ok(lireChapitre(livre.id, ch))
+    assert.equal(cheminDuDepot(chapitre.path), resolve(racine, chapitre.path))
+    if (premier) {
+      assert.equal(texte, premier)
+      assert.deepEqual(folios, premiersFolios)
+    } else {
+      premier = texte
+      premiersFolios = new Map(folios)
+    }
+  }
+} else {
+  test('les livres se lisent à froid depuis un cwd étranger, puis après changement de cwd', () => {
+    const etranger = mkdtempSync(join(tmpdir(), 'livres-cwd-'))
+    try {
+      const enfant = spawnSync(process.execPath, [fileURLToPath(import.meta.url), '--lecture-etrangere'], {
+        cwd: etranger, encoding: 'utf8', timeout: 30_000,
+      })
+      assert.equal(enfant.status, 0, `${enfant.error ?? ''}\n${enfant.stdout}\n${enfant.stderr}`)
+    } finally {
+      rmSync(etranger, { recursive: true, force: true })
+    }
+  })
+}
