droit vers le haut a (3,-50). --><path d="M2.6 -9 C 10 -14 11 -21 4 -26 C -4 -31 -6 -38 0 -43 C 1.4 -45.3 2.4 -47.6 3 -50 C 2.4 -47.8 1.2 -45.6 -1 -43.4 C -8 -38 -10 -30 -4 -25 C 3 -20 9 -16 -1.4 -9.5 Z" fill="#5a3a1f" stroke="#3a2a1a" stroke-width="0.55" stroke-linejoin="round"/><!-- reflet clair courant le long du spine (relief cuir, suit la fibre) --><path d="M0.8 -10 C 7.5 -15 8 -21 1.4 -25.8 C -5.6 -30.6 -7 -37.6 -1.2 -42.6 C 0 -44.5 1 -46.6 1.8 -48.8" fill="none" stroke="#9a7a4a" stroke-width="0.9" stroke-linecap="round" opacity="0.65"/><!-- mouche / claquoir : fin fil prolongeant la pointe (claquement), reste a la pointe (3,-50) --><path d="M3 -50 q1.8 0.6 2.6 -0.4 M3 -50 q1 -1 1.8 -2.2" fill="none" stroke="#3a2a1a" stroke-width="0.8" stroke-linecap="round"/></g></g>"
`;

