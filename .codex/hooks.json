{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Write|Edit|apply_patch|Bash|PowerShell|mcp__lean_ctx__.+)$",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/repartiteur.mjs",
            "timeout": 10,
            "statusMessage": "Gardes des appels d’outil (répartiteur)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:Write|Edit|apply_patch|mcp__lean_ctx__ctx_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/repartiteur.mjs",
            "timeout": 10,
            "statusMessage": "Gardes des appels d’outil (répartiteur)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/synchroniser-principal.mjs",
            "timeout": 300,
            "statusMessage": "Synchronisation du principal sur origin/main"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/inject-project-credo.mjs codex",
            "timeout": 10,
            "statusMessage": "Injection du credo de travail"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/inject-suivi.mjs",
            "timeout": 10,
            "statusMessage": "Suivi de vague de la session"
          }
        ]
      }
    ]
  }
}
