{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|mcp__lean-ctx__ctx_patch|Edit|Bash|PowerShell|mcp__lean-ctx__ctx_shell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/repartiteur.mjs",
            "timeout": 10,
            "statusMessage": "Gardes des appels d’outil (répartiteur)"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__lean-ctx__ctx_shell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/solde-ticket-hook.mjs",
            "timeout": 10,
            "statusMessage": "Fermeture de ticket au commit = solde écrit obligatoire"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/repartiteur.mjs",
            "timeout": 10,
            "statusMessage": "Gardes des appels d’outil (répartiteur)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/inject-project-credo.mjs codex",
            "timeout": 10,
            "statusMessage": "Injection du credo de travail"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/inject-suivi.mjs",
            "timeout": 10,
            "statusMessage": "Suivi de vague de la session"
          }
        ]
      }
    ]
  }
}
