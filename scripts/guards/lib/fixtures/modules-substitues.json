{
  "formes": [
    {
      "cas": "load rendant source, import nommé",
      "texte": [
        "import { registerHooks } from 'node:module'",
        "const url = new URL('./cible.mjs?banc', import.meta.url).href",
        "registerHooks({ load(spec, contexte, suivant) {",
        "  const r = suivant(spec, contexte)",
        "  if (spec !== url) return r",
        "  return { ...r, source: String(r.source).replace('a', 'b') }",
        "} })"
      ],
      "sites": [{ "ligne": 3, "effets": ["source"], "enChaine": false }]
    },
    {
      "cas": "load qui pose source par affectation",
      "texte": [
        "import { registerHooks } from 'node:module'",
        "registerHooks({",
        "  load: (spec, contexte, suivant) => { const r = suivant(spec, contexte); r.source = 'export default 1'; return r },",
        "})"
      ],
      "sites": [{ "ligne": 2, "effets": ["source"], "enChaine": false }]
    },
    {
      "cas": "resolve rendant url pour un spécificateur non node:",
      "texte": [
        "import { registerHooks } from 'node:module'",
        "registerHooks({ resolve(spec, contexte, suivant) {",
        "  if (spec === './collaborateur.mjs') return { url: 'data:text/javascript,export default 1', shortCircuit: true }",
        "  return suivant(spec, contexte)",
        "} })"
      ],
      "sites": [{ "ligne": 2, "effets": ["url"], "enChaine": false }]
    },
    {
      "cas": "crochets load et resolve sur un même appel",
      "texte": [
        "import { registerHooks } from 'node:module'",
        "function charger(spec, contexte, suivant) { return { ...suivant(spec, contexte), source: '' } }",
        "const crochets = { load: charger, resolve(spec, contexte, suivant) { return { url: spec } } }",
        "registerHooks(crochets)"
      ],
      "sites": [{ "ligne": 4, "effets": ["source", "url"], "enChaine": false }]
    },
    {
      "cas": "fichier chargeur passé à register",
      "texte": [
        "import { writeFileSync } from 'node:fs'",
        "import { register } from 'node:module'",
        "writeFileSync('chargeur.mjs', `export async function load(url, contexte, suivant) {",
        "  const r = await suivant(url, contexte)",
        "  return { ...r, source: 'export default 1' }",
        "}`)",
        "register('./chargeur.mjs', import.meta.url)"
      ],
      "sites": [{ "ligne": 3, "effets": ["source"], "enChaine": true }]
    },
    {
      "cas": "fichier chargeur passé à --loader",
      "texte": [
        "import { spawnSync } from 'node:child_process'",
        "import { writeFileSync } from 'node:fs'",
        "writeFileSync('chargeur.mjs', [",
        "  'export const resolve = (spec, contexte, suivant) =>',",
        "  \"  spec.endsWith('/cible.mjs') ? { url: 'file:///ailleurs.mjs', shortCircuit: true } : suivant(spec, contexte)\",",
        "].join('\\n'))",
        "spawnSync(process.execPath, ['--loader', './chargeur.mjs', 'cible.mjs'])"
      ],
      "sites": [{ "ligne": 4, "effets": ["url"], "enChaine": true }]
    },
    {
      "cas": "fichier chargeur passé à --import",
      "texte": [
        "import { spawnSync } from 'node:child_process'",
        "import { writeFileSync } from 'node:fs'",
        "const cible = new URL('./cible.mjs', import.meta.url).href",
        "writeFileSync('observer.mjs', `import { registerHooks } from 'node:module'",
        "registerHooks({ load(url, contexte, suivant) {",
        "  const r = suivant(url, contexte)",
        "  if (url !== ${JSON.stringify(cible)}) return r",
        "  return { ...r, source: String(r.source) + '\\\\nexport const sonde = 1' }",
        "} })",
        "`)",
        "spawnSync(process.execPath, ['--import', './observer.mjs', 'cible.mjs'])"
      ],
