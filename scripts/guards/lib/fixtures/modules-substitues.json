    {
      "cas": "crochet qui vise une fixture de tmp",
      "texte": [
        "import { registerHooks } from 'node:module'",
        "import { mkdtempSync, writeFileSync } from 'node:fs'",
        "import { tmpdir } from 'node:os'",
        "import { join } from 'node:path'",
        "import { pathToFileURL } from 'node:url'",
        "const racine = mkdtempSync(join(tmpdir(), 'banc-'))",
        "const module = join(racine, 'fixture.mjs')",
        "writeFileSync(module, 'export default 1')",
        "const cible = pathToFileURL(module).href",
        "registerHooks({ load(url, contexte, suivant) {",
        "  const r = suivant(url, contexte)",
        "  return url === cible ? { ...r, source: 'export default 2' } : r",
        "} })"
      ],
      "sites": []
    },
