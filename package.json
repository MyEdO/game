{
  "name": "warhammer-v4-rpg",
  "version": "0.1.0",
  "private": true,
  "description": "RPG tactique au tour par tour Warhammer Fantasy v4 (web, type Neverwinter Nights) — en français",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/guards/contrat-typescript.mjs && git config core.hooksPath scripts/git-hooks && git config merge.docs-fiche-raw.driver \"node scripts/git-hooks/merge-docs.mjs fiche-raw %O %A %B %P\" && git config merge.docs-fiche-raw.name \"docs fiche raw: fusion de la prose, champ Implemente reinjecte par identite\" && git config merge.stocks.driver \"node scripts/git-hooks/merge-stocks.mjs %O %A %B %P\" && git config merge.stocks.name \"stocks de sites: fusion par groupe de site\" && node scripts/docs/build-all.mjs --code --quiet",
    "gen": "node scripts/docs/build-all.mjs --code",
    "migrations:replay": "node scripts/migrations/replay.mjs",
    "migrations:replay:head": "node scripts/migrations/replay-head.mjs",
    "migrations:replay:croissance": "node scripts/migrations/replay-croissance.mjs",
    "dev": "node scripts/lancer-local.mjs vite -- vite",
    "build": "npm run gen && node scripts/lancer-local.mjs vite -- vite build",
    "preview": "node scripts/lancer-local.mjs vite -- vite preview",
    "test": "node scripts/test/run.mjs",
    "test:runner": "node scripts/gates/testsSansEcriture.mjs test:runner",
    "test:watch": "node scripts/lancer-local.mjs vitest -- vitest",
    "bench": "node scripts/lancer-local.mjs vitest -- vitest bench --run",
    "agents:sync": "node scripts/agents/compat-cli.mjs sync",
    "agents:check": "node scripts/agents/compat-cli.mjs check",
    "mods:check": "node scripts/mods/verifier.mjs",
    "livraison:plage": "node scripts/guards/livraison-plage.mjs",
    "test:agents": "node scripts/gates/testsSansEcriture.mjs test:agents",
    "test:hooks": "node scripts/gates/testsSansEcriture.mjs test:hooks",
    "banc:pre-commit": "node scripts/test/banc-pre-commit.mjs",
    "test:perimetre": "node --import=./scripts/guards/lib/perimetreSansEcriture.mjs scripts/test/perimetre.mjs",
    "guard:budget-contexte": "node scripts/guards/budget-contexte.mjs",
    "test:docs": "node scripts/gates/testsSansEcriture.mjs test:docs",
    "test:recette": "node scripts/gates/testsSansEcriture.mjs test:recette",
    "test:raw": "node scripts/gates/testsSansEcriture.mjs test:raw",
    "gates": "node scripts/gates/toutes.mjs",
    "typecheck": "node scripts/lancer-local.mjs typescript -- tsc --noEmit --incremental false",
    "typecheck:fast": "node scripts/typecheck-fast.mjs",
    "docs:check": "node scripts/docs/build-all.mjs --check",
    "docs:build": "node scripts/docs/build-all.mjs",
    "docs:primitives": "node scripts/docs/build-primitives.mjs",
    "docs:doctrines": "node scripts/docs/build-doctrines.mjs",
    "docs:dossiers": "node scripts/docs/build-dossiers-de-chapitre.mjs",
    "docs:systemes": "node scripts/docs/build-systemes.mjs",
    "docs:donnees": "node scripts/docs/build-donnees.mjs",
    "docs:sources-vf": "node scripts/docs/build-sources-vf.mjs",
    "docs:effects": "node scripts/docs/build-effects.mjs",
    "docs:vocabulaire": "node scripts/docs/build-vocabulaire.mjs",
    "docs:index-moteur": "node scripts/docs/build-index-moteur.mjs",
    "docs:registre-jets": "node scripts/docs/build-registre-jets.mjs",
    "docs:usages-jets": "node scripts/docs/build-usages-jets.mjs",
    "docs:orphelines": "node scripts/docs/build-entity-orphans.mjs",
    "docs:test-scenarios": "node scripts/docs/build-test-scenarios.mjs",
    "docs:reprise": "node scripts/docs/build-reprise.mjs",
    "docs:icones": "node scripts/docs/build-icones.mjs",
    "docs:codex-relations": "node scripts/docs/build-codex-relations.mjs",
    "docs:map-authoring": "node scripts/docs/build-map-authoring.mjs",
    "docs:passifs": "node scripts/docs/build-passifs.mjs",
    "docs:rendu-pipeline": "node scripts/docs/build-rendu-pipeline.mjs",
    "docs:flux-de-jet": "node scripts/docs/build-flux-de-jet.mjs",
    "docs:mecanique": "node scripts/docs/build-mecanique.mjs",
    "docs:sort": "node scripts/docs/build-sort.mjs",
    "docs:ajouter-donnee": "node scripts/docs/build-ajouter-donnee.mjs",
    "docs:regles-optionnelles": "node scripts/docs/build-regles-optionnelles.mjs",
    "docs:sorts": "node scripts/lancer-local.mjs tsx -- tsx scripts/gen-sorts-doc.mts",
    "docs:field-consumers": "node scripts/lancer-local.mjs tsx -- tsx scripts/docs/build-field-consumers.mts",
    "docs:structures": "node scripts/lancer-local.mjs tsx -- tsx scripts/docs/build-structures.mts",
    "deps:unused": "knip --dependencies && npm run deps:exports",
    "deps:exports": "node scripts/ops/knip-exports-ratchet.mjs",
    "test:ops": "node scripts/gates/testsSansEcriture.mjs test:ops",
    "ops:audit": "node scripts/ops/audit-stock.mjs",
    "ops:stock-issues": "node scripts/ops/stock-issues.mjs",
    "ops:fermetures-non-citees": "node scripts/ops/fermetures-non-citees.mjs",
    "ops:fermer": "node scripts/ops/fermer-depuis-main.mjs",
    "ops:ruleset": "node scripts/ops/ruleset-main.mjs",
    "ops:chantier": "node scripts/ops/chantier.mjs",
    "ops:session": "node scripts/ops/session.mjs",
    "ops:worktrees": "node scripts/ops/worktrees.mjs",
    "ops:publier": "node scripts/ops/publier.mjs",
    "ops:ci": "node scripts/ops/ci.mjs",
    "ops:board": "node scripts/ops/board.mjs",
    "ops:suivi": "node scripts/ops/suivi.mjs",
    "ops:synchroniser": "node scripts/ops/synchroniser.mjs",
    "deps:report": "node scripts/ops/deps-report.mjs",
    "raw:coverage": "node scripts/raw/coverage.mjs",
    "raw:reconcile": "node scripts/raw/reconcile.mjs",
    "raw:check-refs": "node scripts/raw/check-refs.mjs",
    "raw:check-code-refs": "node scripts/raw/check-code-refs.mjs && node scripts/raw/citation-graphy-guard.mjs",
    "raw:check-ancres": "node scripts/raw/check-ancres.mjs",
    "raw:check-entity-in-chapter": "node scripts/raw/check-entity-in-chapter.mjs",
    "raw:check-catalogue-complete": "node scripts/raw/check-catalogue-complete.mjs",
    "raw:check-folio-continuity": "node scripts/raw/check-folio-continuity.mjs",
    "raw:check-source-format": "node scripts/raw/check-source-format.mjs",
    "raw:check-source-tables": "node scripts/raw/check-source-tables.mjs",
    "raw:check-source-puces": "node scripts/raw/check-source-puces.mjs",
    "raw:check-renvois": "node scripts/raw/check-renvois.mjs",
    "raw:releve": "node scripts/raw/releve.mjs",
    "raw:paquet": "node scripts/raw/paquet.mjs",
    "raw:tri": "node scripts/raw/tri.mjs",
    "raw:implemente": "node scripts/raw/build-implemente.mjs",
    "raw:reanchor": "node scripts/raw/reanchor.mjs",
    "raw:reanchor-split": "node scripts/raw/reanchor-split.mjs",
    "raw:catalogs": "node scripts/raw/build-catalogs.mjs",
    "lint": "node scripts/lancer-local.mjs oxlint -- oxlint --config oxlint.config.mjs --disable-nested-config . --max-warnings 0",
    "server:typecheck": "npm --prefix server run typecheck",
    "relay:dev": "npm --prefix server run dev",
    "relay:deploy": "npm --prefix server run deploy",
    "galleries": "node scripts/gen-galleries.mjs",
    "recette:shot": "node scripts/recette/shot-screen.mjs",
    "stocks:regen": "node scripts/lancer-local.mjs tsx -- tsx scripts/guards/lib/regenStock.mts --tous",
    "map:check": "node scripts/lancer-local.mjs tsx -- tsx scripts/map/check.mts",
    "test:map": "node scripts/lancer-local.mjs vitest -- vitest run scripts/map"
  },
  "dependencies": {
    "@fontsource/grenze-gotisch": "^5.2.8",
    "micromark-util-decode-string": "2.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^30.1.1",
    "knip": "^6.26.0",
    "oxlint": "1.86.0",
    "rolldown": "^1.2.12",
    "semver": "^7.8.5",
    "tsx": "^4.19.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
