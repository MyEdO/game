{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/**/*.test.ts",
    "hotes/**/*.test.ts",
    "projets/**/*.test.ts",
    "scripts/**/*.{mjs,mts,ts}",
    "!scripts/test/lib/**",
    "src/**/*.generated.ts",
    "hotes/texte/serveur.ts",
    "hotes/godot/pont/entree.ts",
    "hotes/godot/recettes/*.ts",
    "hotes/godot/cibles/propositions/sources/rendre.mjs",
    "projets/roguelite/src/main.ts",
    "projets/roguelite/construire.mjs",
    "projets/roguelite/recette/*.{mjs,ts}",
    "projets/roguelite/{balayage,equilibrage,catalogue}.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "hotes/**/*.{ts,tsx,mjs}",
    "projets/**/*.{ts,tsx,mjs}",
    "scripts/**/*.{mjs,mts,ts}"
  ],
  "ignore": [
    "server/**",
    "dist/**",
    "public/**",
    ".claude/skills/*/{hooks,types,tests}/**"
  ],
  "ignoreBinaries": ["compare", "convert", "ffmpeg", "lean-ctx"],
  "ignoreDependencies": ["oxlint"],
  "oxlint": { "config": ["oxlint.config.mjs"] },
  "ignoreExportsUsedInFile": true
}
