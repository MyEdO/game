{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "scripts/**/*.{mjs,mts,ts}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,mts,ts}"
  ],
  "ignore": [
    "server/**",
    "scripts/data/.out/**",
    "dist/**",
    "public/**"
  ],
  "ignoreBinaries": ["lean-ctx"],
  "ignoreExportsUsedInFile": true
}
