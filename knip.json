{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "hotes/**/*.hors-store.test.ts",
    "scripts/**/*.{mjs,mts,ts}",
    "!scripts/test/lib/**",
    "src/**/*.generated.ts",
    "src/hoteTexte/serveur.ts",
    "hotes/godot/pont/entree.ts",
    "hotes/godot/recettes/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "hotes/**/*.{ts,tsx,mjs}",
    "scripts/**/*.{mjs,mts,ts}"
  ],
  "ignore": [
    "server/**",
    "dist/**",
    "public/**",
    ".claude/skills/*/{hooks,types,tests}/**"
  ],
  "ignoreBinaries": ["ffmpeg", "lean-ctx"],
  "ignoreDependencies": ["oxlint"],
  "oxlint": { "config": ["oxlint.config.mjs"] },
  "ignoreExportsUsedInFile": true
}
