{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "scripts/**/*.{mjs,mts,ts}",
    "!scripts/test/lib/**",
    "src/**/*.generated.ts",
    "src/noyau/index.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,mts,ts}"
  ],
  "ignore": [
    "server/**",
    "dist/**",
    "public/**",
    ".claude/skills/*/{hooks,types,tests}/**"
  ],
  "ignoreBinaries": ["lean-ctx"],
  "ignoreDependencies": ["oxlint"],
  "oxlint": { "config": ["oxlint.config.mjs"] },
  "ignoreExportsUsedInFile": true
}
